<%- include('partials/header') %>

<section class="bg-navybrand-900 text-white py-12 border-b border-navybrand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
        <span class="text-skybrand-300 font-extrabold text-xs uppercase tracking-widest bg-white/10 px-3 py-1 rounded-full border border-white/20">Official Pricelist</span>
        <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">Daftar Harga Sewa Alat Terbaru</h1>
        <p class="text-slate-300 text-sm max-w-2xl mx-auto">Harga transparan tanpa biaya tersembunyi. Tersedia pilihan durasi 6 Jam, 12 Jam, dan 24 Jam.</p>
    </div>
</section>

<section class="py-14 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <% categories.forEach(cat => { %>
        <% if (cat.products && cat.products.length > 0) { %>
        <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-slate-200">
            <div class="bg-gradient-to-r from-navybrand-900 to-navybrand-800 text-white px-6 py-4 flex items-center justify-between">
                <h2 class="text-lg font-bold flex items-center gap-2">
                    <i class="fa-solid <%= cat.icon %> text-skybrand-300"></i>
                    <span>Kategori: <%= cat.name %></span>
                </h2>
                <span class="text-xs bg-white/10 px-3 py-1 rounded-full font-medium"><%= cat.products.length %> Item</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700 text-xs uppercase font-extrabold border-b border-slate-200">
                            <th class="py-3.5 px-6">Nama Peralatan</th>
                            <th class="py-3.5 px-4">Brand</th>
                            <th class="py-3.5 px-4 text-center">Harga 6 Jam</th>
                            <th class="py-3.5 px-4 text-center">Harga 12 Jam</th>
                            <th class="py-3.5 px-4 text-center">Harga 24 Jam</th>
                            <th class="py-3.5 px-6 text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs font-semibold text-slate-700">
                        <% cat.products.forEach(p => { %>
                        <tr class="hover:bg-skybrand-50/40 transition-colors">
                            <td class="py-4 px-6 font-bold text-navybrand-800 flex items-center space-x-3">
                                <img src="<%= p.image_url %>" alt="<%= p.name %>" class="w-10 h-10 object-contain bg-white border border-slate-200 rounded-lg p-0.5">
                                <a href="/product-detail/<%= p.id %>" class="hover:text-skybrand-500"><%= p.name %></a>
                            </td>
                            <td class="py-4 px-4 text-slate-500 font-semibold"><%= p.brand %></td>
                            <td class="py-4 px-4 text-center text-slate-600 font-bold"><%= p.ratesMap['6 Jam'] ? formatRupiah(p.ratesMap['6 Jam']) : '-' %></td>
                            <td class="py-4 px-4 text-center text-slate-600 font-bold"><%= p.ratesMap['12 Jam'] ? formatRupiah(p.ratesMap['12 Jam']) : '-' %></td>
                            <td class="py-4 px-4 text-center text-skybrand-600 font-extrabold text-sm"><%= p.ratesMap['24 Jam'] ? formatRupiah(p.ratesMap['24 Jam']) : '-' %></td>
                            <td class="py-4 px-6 text-right">
                                <div class="inline-flex items-center space-x-1.5">
                                    <button type="button"
                                            class="btnQuickAddToCart bg-skybrand-50 hover:bg-skybrand-500 hover:text-white text-skybrand-600 font-extrabold px-3 py-1.5 rounded-lg text-xs transition-colors flex items-center space-x-1"
                                            data-product-id="<%= p.id %>"
                                            data-product-name="<%= p.name %>"
                                            data-product-brand="<%= p.brand %>"
                                            data-product-image="<%= p.image_url %>"
                                            data-duration="24 Jam"
                                            data-price="<%= p.ratesMap['24 Jam'] || p.ratesMap['12 Jam'] || p.ratesMap['6 Jam'] || 0 %>">
                                        <i class="fa-solid fa-cart-plus text-xs"></i>
                                        <span>+ Cart</span>
                                    </button>
                                    <a href="/product-detail/<%= p.id %>" class="bg-navybrand-800 hover:bg-navybrand-900 text-white font-bold px-3 py-1.5 rounded-lg transition-colors text-xs flex items-center space-x-1">
                                        <span>Detail</span>
                                        <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>
        <% }); %>
    </div>
</section>

<%- include('partials/footer') %>
