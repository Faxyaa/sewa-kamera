<%- include('partials/header') %>

<% const initialRate = rates && rates.length > 0 ? rates[rates.length - 1] : { duration_type: '24 Jam', price: 0 }; %>

<div class="bg-slate-100/70 backdrop-blur border-b border-slate-200 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex text-xs font-semibold text-slate-500 space-x-2">
            <a href="/" class="hover:text-skybrand-500">Home</a>
            <span>/</span>
            <a href="/?category=<%= product.category_slug %>#katalog" class="hover:text-skybrand-500"><%= product.category_name %></a>
            <span>/</span>
            <span class="text-slate-800 font-bold truncate max-w-xs"><%= product.name %></span>
        </nav>
    </div>
</div>

<section class="py-12 bg-slate-50 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <div class="lg:col-span-8 space-y-8">
                <!-- Frosted Glass Main Detail Box -->
                <div class="glass-panel rounded-3xl p-6 sm:p-9 shadow-lg border border-white/80 grid grid-cols-1 md:grid-cols-2 gap-9">
                    
                    <div class="space-y-6">
                        <div class="relative bg-white/90 backdrop-blur border border-slate-200/80 rounded-3xl p-6 h-76 flex items-center justify-center overflow-hidden shadow-inner">
                            <img id="mainProductImage" src="<%= product.image_url %>" alt="<%= product.name %>" class="max-h-64 object-contain transition-transform duration-300 filter drop-shadow-lg">
                            <div class="absolute top-3.5 left-3.5 flex flex-col space-y-1 z-10">
                                <% if (product.is_bestseller) { %><span class="bg-amber-500/90 backdrop-blur text-white text-[10px] font-extrabold px-3 py-0.5 rounded-full uppercase shadow">Best Seller</span><% } %>
                                <% if (product.is_new) { %><span class="bg-emerald-500/90 backdrop-blur text-white text-[10px] font-extrabold px-3 py-0.5 rounded-full uppercase shadow">NEW</span><% } %>
                            </div>
                        </div>

                        <div class="flex items-center space-x-3">
                            <img src="<%= product.image_url %>" data-src="<%= product.image_url %>" class="product-thumb w-16 h-16 object-contain bg-white border border-slate-200 rounded-2xl p-1 cursor-pointer ring-2 ring-sky-500 shadow-sm" alt="Main Thumb">
                            <img src="<%= product.image_url %>" data-src="<%= product.image_url %>" class="product-thumb w-16 h-16 object-contain bg-white border border-slate-200 rounded-2xl p-1 cursor-pointer hover:border-sky-400 opacity-80 hover:opacity-100 transition-opacity" alt="Angle 2">
                        </div>

                        <div class="bg-skybrand-50/70 backdrop-blur border border-skybrand-100 rounded-2xl p-5 space-y-3">
                            <h4 class="text-xs font-extrabold uppercase tracking-wider text-navybrand-800 flex items-center gap-2">
                                <i class="fa-solid fa-box-open text-skybrand-500"></i>
                                <span>Kelengkapan Paket Sewa:</span>
                            </h4>
                            <% if (product.kelengkapan) { %>
                            <ul class="text-xs text-slate-700 space-y-1.5 list-disc list-inside font-medium">
                                <% product.kelengkapan.split(',').forEach(item => { %>
                                <li class="leading-relaxed"><%= item.trim() %></li>
                                <% }); %>
                            </ul>
                            <% } else { %>
                            <p class="text-xs text-slate-500">Unit Utama, Baterai, Charger, Tas Anti Air.</p>
                            <% } %>
                        </div>
                    </div>

                    <div class="flex flex-col justify-between space-y-6">
                        <div>
                            <div class="flex items-center space-x-2 mb-2">
                                <span class="bg-skybrand-100/90 text-skybrand-600 font-extrabold text-[10px] px-3 py-1 rounded-lg uppercase tracking-wider"><%= product.category_name %></span>
                                <span class="text-xs font-bold text-slate-400">Brand: <%= product.brand %></span>
                            </div>

                            <h1 class="text-2xl sm:text-3xl font-extrabold text-navybrand-800 leading-snug"><%= product.name %></h1>
                            <p class="text-xs text-slate-600 mt-3 leading-relaxed font-medium"><%= product.description %></p>
                        </div>

                        <!-- Duration Selector Pills -->
                        <div class="space-y-3">
                            <label class="block text-xs font-extrabold text-navybrand-800 uppercase tracking-wider">Pilih Durasi Sewa:</label>
                            <div class="grid grid-cols-3 gap-2.5">
                                <% rates.forEach(rate => { %>
                                <% const isDefault = (rate.duration_type === initialRate.duration_type); %>
                                <div class="rate-pill p-3 rounded-2xl text-center <%= isDefault ? 'active' : '' %>"
                                     data-duration="<%= rate.duration_type %>"
                                     data-price="<%= rate.price %>"
                                     data-price-formatted="<%= formatRupiah(rate.price) %>"
                                     data-product-name="<%= product.name %>"
                                     data-wa-num="<%= siteInfo.waInt %>">
                                    <span class="block text-[11px] font-semibold"><%= rate.duration_type %></span>
                                    <span class="block text-xs font-extrabold mt-0.5"><%= formatRupiah(rate.price) %></span>
                                </div>
                                <% }); %>
                            </div>
                        </div>

                        <!-- Price & Contact Action Buttons (WhatsApp & Instagram Side-by-Side) -->
                        <div class="pt-4 border-t border-slate-100 space-y-4">
                            <div class="bg-slate-100/80 backdrop-blur p-3.5 rounded-2xl flex items-center justify-between border border-slate-200/80">
                                <span class="text-xs text-slate-500 font-semibold">Total Biaya (<span id="selectedDurationText"><%= initialRate.duration_type %></span>):</span>
                                <span id="selectedDurationPrice" class="text-xl font-extrabold text-navybrand-800"><%= formatRupiah(initialRate.price) %></span>
                            </div>

                            <% const waText = "Halo Admin Sewa Kamera Malang, saya mau sewa " + product.name + " untuk durasi " + initialRate.duration_type; %>
                            <% const waUrl = "https://wa.me/" + siteInfo.waInt + "?text=" + encodeURIComponent(waText); %>
                            
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <!-- Add to Cart Button -->
                                <button id="btnAddToCartDetail"
                                        data-product-id="<%= product.id %>"
                                        data-product-name="<%= product.name %>"
                                        data-product-brand="<%= product.brand %>"
                                        data-product-image="<%= product.image_url %>"
                                        data-duration="<%= initialRate.duration_type %>"
                                        data-price="<%= initialRate.price %>"
                                        class="bg-gradient-to-r from-navybrand-800 to-skybrand-600 hover:from-navybrand-900 hover:to-skybrand-700 text-white font-extrabold py-3.5 px-4 rounded-2xl shadow-lg transition-all flex items-center justify-center space-x-2 text-xs">
                                    <i class="fa-solid fa-cart-plus text-lg"></i>
                                    <span>+ Keranjang</span>
                                </button>

                                <!-- WhatsApp Direct Booking -->
                                <a id="btnChatWa" href="<%= waUrl %>" target="_blank" class="bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-extrabold py-3.5 px-4 rounded-2xl shadow-lg transition-all flex items-center justify-center space-x-2 btn-wa-pulse text-xs">
                                    <i class="fa-brands fa-whatsapp text-lg"></i>
                                    <span>Chat WA Direct</span>
                                </a>
                            </div>

                            <p class="text-[11px] text-slate-400 text-center flex items-center justify-center gap-1">
                                <i class="fa-solid fa-shield-check text-emerald-500"></i>
                                <span>Bisa sewa banyak unit sekaligus lewat keranjang.</span>
                            </p>
                        </div>
                    </div>

                </div>
            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="lg:col-span-4 space-y-6">
                <div class="glass-panel rounded-3xl p-6 border border-white/80 shadow-md space-y-4">
                    <h3 class="font-extrabold text-navybrand-800 text-base border-b border-slate-100 pb-3 flex items-center justify-between">
                        <span>Kategori Kamera & Lensa</span>
                        <i class="fa-solid fa-layer-group text-skybrand-400 text-sm"></i>
                    </h3>
                    <ul class="space-y-2 text-xs font-semibold">
                        <% categories.forEach(scat => { %>
                        <li>
                            <a href="/?category=<%= scat.slug %>#katalog" class="flex items-center justify-between p-3 rounded-2xl hover:bg-skybrand-50/80 hover:text-skybrand-600 transition-colors text-slate-700">
                                <span class="flex items-center gap-2.5">
                                    <i class="fa-solid <%= scat.icon %> text-skybrand-400 w-4 text-center"></i>
                                    <span><%= scat.name %></span>
                                </span>
                                <span class="bg-slate-100 text-slate-500 text-[10px] px-2.5 py-0.5 rounded-full font-bold"><%= scat.total_items %></span>
                            </a>
                        </li>
                        <% }); %>
                    </ul>
                </div>

                <div class="glass-panel rounded-3xl p-6 border border-white/80 shadow-md space-y-4">
                    <h3 class="font-extrabold text-navybrand-800 text-base border-b border-slate-100 pb-3 flex items-center justify-between">
                        <span>Top Kamera & Lensa</span>
                        <i class="fa-solid fa-fire text-amber-500 text-sm"></i>
                    </h3>
                    <div class="space-y-4">
                        <% topProducts.forEach(titem => { %>
                        <a href="/product-detail/<%= titem.id %>" class="flex items-center space-x-3 group">
                            <div class="w-16 h-16 bg-white border border-slate-200 rounded-2xl p-1.5 flex-shrink-0 flex items-center justify-center shadow-sm">
                                <img src="<%= titem.image_url %>" alt="<%= titem.name %>" class="max-h-12 object-contain group-hover:scale-105 transition-transform">
                            </div>
                            <div class="flex-grow min-w-0">
                                <h4 class="font-bold text-xs text-navybrand-800 truncate group-hover:text-skybrand-500 transition-colors"><%= titem.name %></h4>
                                <span class="text-xs font-extrabold text-skybrand-600 block mt-0.5"><%= formatRupiah(titem.price_24h) %> <span class="text-[9px] font-normal text-slate-400">/24j</span></span>
                            </div>
                        </a>
                        <% }); %>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<%- include('partials/footer') %>
